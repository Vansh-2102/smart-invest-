# Database Configuration (Supabase / PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.your_project_ref
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# Security & JWT Configuration
JWT_SECRET=investment-guidance-super-secret-key-for-jwt-token-generation-must-be-at-least-256-bits-long
JWT_EXPIRATION=86400000

# Service Routing & Server Port
SERVER_PORT=8081
AI_ML_SERVICE_URL=http://localhost:8000

# Supabase Project Credentials
SUPABASE_PROJECT_URL=https://your_project_ref.supabase.co
SUPABASE_PUBLIC_KEY=your_supabase_public_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
