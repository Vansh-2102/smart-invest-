spring.application.name=investment-guidance

# Supabase PostgreSQL Database Configuration
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:postgres.your_project_ref}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:YOUR_DATABASE_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# HikariCP Pool settings for Supabase pooler / production connection management
spring.datasource.hikari.max-lifetime=60000
spring.datasource.hikari.keepalive-time=30000
spring.datasource.hikari.connection-timeout=20000
spring.datasource.hikari.minimum-idle=2

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

server.port=${SERVER_PORT:8081}

# JWT Security Configuration
jwt.secret=${JWT_SECRET:investment-guidance-super-secret-key-for-jwt-token-generation-must-be-at-least-256-bits-long}
jwt.expiration=86400000

# ML / AI Service URL (use http://ml:8000 inside Docker or http://localhost:8000 locally)
ai.ml-service-url=${AI_ML_SERVICE_URL:http://localhost:8000}

# Swagger / OpenAPI Documentation
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html

# Supabase Configuration
supabase.project.url=${SUPABASE_PROJECT_URL:https://your_project_ref.supabase.co}
supabase.api.public.key=${SUPABASE_PUBLIC_KEY:YOUR_SUPABASE_PUBLIC_KEY}
supabase.api.secret.key=${SUPABASE_SECRET_KEY:YOUR_SUPABASE_SECRET_KEY}
