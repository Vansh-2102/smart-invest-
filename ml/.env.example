# API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gpt-oss-120b
MISTRAL_API_KEY=your_mistral_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Qdrant Vector Database Configuration (Optional)
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# HuggingFace Token (for Transformer / Embeddings models)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_token_here

# Application Environment
APP_ENV=development
DEBUG=True

# Supabase Configuration
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
